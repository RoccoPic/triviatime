# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Local:      postgresql://user:password@localhost:5432/trivia_time?schema=public
# Production: use Neon (neon.tech) — copy the connection string from your project dashboard
DATABASE_URL="postgresql://user:password@localhost:5432/trivia_time?schema=public"

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
# NEXTAUTH_URL must exactly match the deployed domain (including https://)
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Required for: question generator (scripts/generate-questions.ts)
#               Facts4U web search phase (scripts/facts4u.ts)
# Get a key at: https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."
