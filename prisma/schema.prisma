generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String             @id @default(cuid())
  email           String?            @unique
  name            String?
  emailVerified   DateTime?
  image           String?
  passwordHash    String?
  collectionMoney Int                @default(0)
  upgExtraLife    Boolean            @default(false)
  upgHeadStart    Boolean            @default(false)
  upgLuckyStreak  Boolean            @default(false)
  upgMoneyBonus   Boolean            @default(false)
  upgReducedSkip  Boolean            @default(false)
  upgResilience   Boolean            @default(false)
  upgSecondWind   Boolean            @default(false)
  upgShield       Boolean            @default(false)
  upgStartDiff    Boolean            @default(false)
  accounts        Account[]
  achievements    UserAchievement[]
  runs            Run[]
  sessions        Session[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  questions     Question[]
  subcategories Subcategory[]
}

model Subcategory {
  id         String     @id @default(cuid())
  categoryId String
  slug       String
  name       String
  questions  Question[]
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model Question {
  id              String       @id @default(cuid())
  categoryId      String
  subcategoryId   String?
  text            String
  options         Json
  correctIndex    Int
  difficultyScore Int          @default(50)
  citation        String?
  verified        Boolean      @default(false)
  confidence      Float?
  answers         Answer[]
  category        Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategory     Subcategory? @relation(fields: [subcategoryId], references: [id])

  @@index([categoryId])
  @@index([categoryId, difficultyScore])
  @@index([subcategoryId])
  @@index([verified])
}

model Run {
  id                  String    @id @default(cuid())
  userId              String
  startedAt           DateTime  @default(now())
  endedAt             DateTime?
  livesRemaining      Int       @default(3)
  runMoney            Int       @default(0)
  currentFloor        Int       @default(1)
  score               Int       @default(0)
  won                 Boolean?
  floorCategoryOrder  Json?
  playerDifficulty    Int       @default(50)
  diffStepRun         Int       @default(5)
  freeMulligan        Int       @default(0)
  freezeCount         Int       @default(0)
  hasFiftyFifty       Boolean   @default(false)
  hasHint             Boolean   @default(false)
  moneyMultiplier     Float     @default(1.0)
  moneyPerCorrectRun  Int       @default(15)
  secondWindAvailable Boolean   @default(false)
  shieldCount         Int       @default(0)
  skipCostRun         Int       @default(28)
  streakForLifeRun    Int       @default(3)
  currentNodeId       String?
  mapData             Json?
  wave                Int       @default(1)
  // Relics: passive run items (JSON array of relic IDs); persist across wave progressions
  relics              Json      @default("[]")
  // Set to currentNodeId when a boss/elite clear earns a relic pick; cleared after picking
  pendingRelicNodeId  String?
  // Combo: consecutive correct answers — resets on wrong answer or skip
  comboCount          Int       @default(0)
  // Lowest lives reached during the run — used for comeback-kid / survivor achievements
  lowestLives         Int       @default(3)
  answers             Answer[]
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

model Answer {
  id             String   @id @default(cuid())
  runId          String
  questionId     String
  correct        Boolean
  skipped        Boolean  @default(false)
  answeredAt     DateTime @default(now())
  floorIndex     Int
  encounterIndex Int
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  run            Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([runId, questionId])
}
