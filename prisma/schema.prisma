generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String?   @unique
  name            String?
  emailVerified   DateTime?
  image           String?
  passwordHash    String?   @db.Text
  collectionMoney Int       @default(0)
  accounts        Account[]
  sessions        Session[]
  runs            Run[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  questions   Question[]
  subcategories Subcategory[]
}

model Subcategory {
  id         String    @id @default(cuid())
  categoryId String
  slug       String
  name       String
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  questions  Question[]
}

model Question {
  id              String    @id @default(cuid())
  categoryId      String
  subcategoryId   String?
  text            String    @db.Text
  options         Json      // string[]
  correctIndex    Int
  difficultyScore Int       @default(50) // 1-100: lower = easier, higher = harder; updated when users answer
  category        Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategory     Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  answers         Answer[]

  @@index([categoryId])
  @@index([categoryId, difficultyScore])
  @@index([subcategoryId])
}

model Run {
  id                 String    @id @default(cuid())
  userId             String
  startedAt          DateTime  @default(now())
  endedAt            DateTime?
  livesRemaining     Int       @default(3)
  runMoney           Int       @default(0)
  currentFloor       Int       @default(1)
  score              Int       @default(0)
  won                Boolean?
  floorCategoryOrder Json?     // number[] category ids per floor
  playerDifficulty   Int       @default(50) // 1-100: adapts per answer, lower = easier
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers            Answer[]

  @@index([userId])
}

model Answer {
  id             String   @id @default(cuid())
  runId          String
  questionId     String
  correct        Boolean
  skipped        Boolean  @default(false)
  answeredAt     DateTime @default(now())
  floorIndex     Int
  encounterIndex Int
  run            Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([runId, questionId])
}
